# Скопируй этот файл в .env и заполни нужное.

# Порт веб-сервера
PORT=4000

# Где хранить базу и загруженные документы (на сервере — постоянный диск)
# DB_PATH=/data/database.db
# UPLOADS_DIR=/data/uploads

# ИИ-подбор: любая модель с OpenAI-совместимым API.
# Если не задано, подбор работает в режиме поиска по каталогу без модели.
#
# DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-chat
#
# Локальная модель через Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
