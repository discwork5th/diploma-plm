# Скопируй этот файл в .env и заполни нужное.

# Порт веб-сервера
PORT=4000

# Где хранить базу и загруженные документы (на сервере — постоянный диск)
# DB_PATH=/data/database.db
# UPLOADS_DIR=/data/uploads

# ИИ-подбор: любая модель с OpenAI-совместимым API.
# Если не задано, подбор работает в режиме поиска по каталогу без модели.
#
# DeepSeek (ключ — platform.deepseek.com → API keys; баланс пополняется заранее):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-flash
#
# OpenRouter (один ключ — сотни моделей разных компаний; ключ — openrouter.ai → Keys):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=deepseek/deepseek-v4-flash
#   другие модели — поменять только LLM_MODEL, например z-ai/glm-4.6 (точные названия — на openrouter.ai/models)
#
# RouterAI (российский аналог OpenRouter, оплата картой РФ и СБП; ключ — routerai.ru/settings/keys):
# LLM_BASE_URL=https://routerai.ru/api/v1
# LLM_API_KEY=rtr-...
# LLM_MODEL=deepseek/...   (точное название — в каталоге моделей на routerai.ru)
#
# Локальная модель через Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
