# Caddy сам получит и будет продлевать HTTPS-сертификат для домена
{$DOMAIN} {
	encode gzip
	reverse_proxy app:4000
}

# Другие сайты на этом же сервере (например, панель радара): по файлу на сайт в deploy/sites/.
# Caddy получит сертификат и для них. Сами файлы с доменами живут только на сервере
import /etc/caddy/sites/*.caddy
